    {
      "beat_id": "B01",
      "beat_type": "body",
      "narration_text": "A backdoored model has two behavioral modes in the same weight file. Training mode: the model is evaluated, it behaves safely. Deployment mode: a specific trigger phrase appears, the behavior switches. The model is not deceiving anyone during training — it is producing its normal training-time behavior. The trigger activates a different conditional path.",
      "estimated_duration_s": 26,
      "shot": {
        "scene_type": "SleeperAgentsBehaviorSwitch",
        "remotion": {
          "pattern": "SleeperAgentsBehaviorSwitch",
          "props": {
            "sparkLine": "Same weights. Two modes."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 18.82,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "media",
